[sub_resource type="GDScript" id="GDScript_bo1ho"]
script/source = "extends Node
#This node is for controlling the game. aka the spawns and what not.

#Connections
@onready var play_button: Button = $\"../PlayButton\"
@onready var Currency: Label = $\"../Label\"
@onready var ray_cast_2d: RayCast2D = $\"../RayCast2D\"
@onready var timer: Label = $\"../Timer\"
@onready var title: Label = $\"../Title\"


#Meteor types.
var Meteor2 = preload(\"res://meteor_2.tscn\")
var Meteor = preload(\"res://scenes/meteor.tscn\")

#Variables.
var TimeLeft = 60
var minerals = 0
var meteorsLeft = 0
var MeteorsToSpawn = 5
var playing = false
var intermission = false
var WaveCounter = 0

#Code below! beware!

func _process(_delta: float) -> void:
	Currency.text = \"Minerals : \" + str(minerals)
	
	



# This timer runs every 4.2 seconds, its used for spawning meteors and handling meteor related variables sometimes.
func _on_timer_timeout() -> void:
	if playing == true and intermission == false and  MeteorsToSpawn > 0:
		var weight = randi_range(1,3)
		var choosen_meteor = null
		if weight <= 2:
			choosen_meteor = Meteor
		else:
			choosen_meteor = Meteor2
		var instance = choosen_meteor.instantiate()
		var random_x_pos = randi_range(-237, 241)
		var random_y_pos = randi_range(-131, 75)
		instance.position = Vector2(random_x_pos, random_y_pos)
		add_child(instance)
		MeteorsToSpawn -= 1
		
		meteorsLeft += 1
		
	


func _on_play_button_pressed() -> void:
	playing = true
	intermission = false
	play_button.visible = false
	ray_cast_2d.visible = true
	Currency.visible = true
	WaveCounter += 1
	title.visible = false

#The timer below runs every second, handling most game logic.
func _on_timer_2_timeout() -> void:
	if intermission == true:
		ray_cast_2d.visible = false
		play_button.visible = true
	if MeteorsToSpawn <= 0 and meteorsLeft <= 0:
		TimeLeft = 0
	print(meteorsLeft)
	print(MeteorsToSpawn)
	
	if playing == true and intermission == false:
		timer.visible = true
		TimeLeft -= 1
		timer.text = \"TIME LEFT : \" + str(TimeLeft)
		if TimeLeft <= 0:
			meteorsLeft = 0
			intermission = true
			TimeLeft = 60
			MeteorsToSpawn = 5
			timer.visible = false
			ray_cast_2d.visible = false
			playing = false
			var fart = get_children()
			for child in fart:
				if child is Evil_meteor:
					child.queue_free()
					
"

